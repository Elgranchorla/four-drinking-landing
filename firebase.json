{
  "hosting": {
    "site": "four-drinking-landing",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "/privacidad",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "/terminos",
        "type": 301
      },
      {
        "source": "/legal",
        "destination": "/aviso-legal",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
